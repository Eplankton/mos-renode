# Facts about this board for the shell scripts (build.sh, emulation/run.sh,
# emulation/selftest.sh, benchmark runners). Sourced by emulation/renode.sh.
BOARD_TITLE="SiFive HiFive1 (RV32IMAC)"
BOARD_GDB=riscv-none-elf-gdb     # From the xPack toolchain
BOARD_SHELL_UART=sysbus.uart0    # Renode name of the shell UART
BOARD_RB_TIMER_HZ=               # Benchmark ports are Cortex-M only
