// HiFive1 = Renode's FE310 model + board parts, matched to real hardware.
using "platforms/cpus/sifive-fe310.repl"

// mtime runs from the 32.768 kHz RTC oscillator on the HiFive1
clint:
    frequency: 32768

// Green LED on GPIO19 (active low)
greenLED: Miscellaneous.LED @ gpioInputs 19

gpioInputs:
    19 -> greenLED@0

// Machine-id strap on GPIO9 (pressed = machine 1)
idButton: Miscellaneous.Button @ gpioInputs 9
    -> gpioInputs@9
