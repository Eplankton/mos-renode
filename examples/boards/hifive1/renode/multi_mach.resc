:name: HiFive1 Multiple Machines
:description: M1 and M2 connected via a UART hub (UART1), Shell on UART0

# Run from the repository root:
#   renode --console examples/boards/hifive1/renode/multi_mach.resc
$bin_path?=$CWD/build/hifive1/hifive1.elf

$name1?="M1"
$name2?="M2"

emulation CreateUARTHub "uart_hub"

# ---------------- Machine 1 ----------------
mach create $name1
include $ORIGIN/board.resc
# Renode's SiFive_GPIO latches an external level only on pins whose
# input_en AND output_en bits are already set (silicon only needs input_en).
# Set both for the id strap (GPIO9) before pressing; the firmware's GPIO
# init uses read-modify-write and keeps them.
sysbus WriteDoubleWord 0x10012004 0x200
sysbus WriteDoubleWord 0x10012008 0x200
gpioInputs.idButton Press
machine StartGdbServer 1234

emulation CreateServerSocketTerminal 3333 "uart-con1" false
connector Connect sysbus.uart0 uart-con1
connector Connect sysbus.uart1 uart_hub

# ---------------- Machine 2 ----------------
mach create $name2
include $ORIGIN/board.resc
machine StartGdbServer 1235

emulation CreateServerSocketTerminal 3334 "uart-con2" false
connector Connect sysbus.uart0 uart-con2
connector Connect sysbus.uart1 uart_hub

# Readiness marker used by emulation/run.sh
echo "MOS_RENODE_READY"
