# Facts about this board for the shell scripts (build.sh, emulation/run.sh,
# emulation/selftest.sh, benchmark runners). Sourced by emulation/renode.sh.
BOARD_TITLE="STM32F4 Discovery (Cortex-M4)"
BOARD_GDB=arm-none-eabi-gdb
BOARD_SHELL_UART=sysbus.usart2   # Renode name of the shell UART
BOARD_RB_TIMER_HZ=10000000       # RTOS-Benchmark timer clock in Renode (TIM2); empty = no benchmarks
BOARD_FREERTOS=yes               # FreeRTOS reference builds (benchmarks/compare.sh)
