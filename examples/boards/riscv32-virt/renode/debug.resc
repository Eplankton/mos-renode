:name: RISC-V32 Virtual
:description: MOS RTOS on Renode's RISC-V32 Virtual (RV32IMAC)

# Run from the repository root:
#   renode --console examples/boards/riscv32-virt/renode/debug.resc
# Then connect riscv-none-elf-gdb to localhost:1234.
$name?="RISCV32-VIRT"
$bin_path?=$CWD/build/riscv32-virt/riscv32-virt.elf

mach create $name
include $ORIGIN/board.resc

machine StartGdbServer 1234

# Shell UART (UART0) -> TCP 3333
emulation CreateServerSocketTerminal 3333 "uart-con" false
connector Connect sysbus.uart0 uart-con

# Readiness marker used by emulation/run.sh
echo "MOS_RENODE_READY"
