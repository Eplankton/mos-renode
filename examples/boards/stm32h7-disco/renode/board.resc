# STM32H747I-DISCO (Cortex-M7): machine setup shared by debug.resc, multi_mach.resc,
# emulation/selftest.sh and the benchmark runners. Expects $bin_path.

machine LoadPlatformDescription @platforms/boards/stm32h747-disco.repl
machine LoadPlatformDescription $ORIGIN/add_on.repl

# The H7 BSP runs from HSI (64 MHz).
sysbus.nvic Frequency 64000000

macro reset
"""
    sysbus LoadELF $bin_path
"""
runMacro $reset

logLevel -1 gpioPortA.myLED
