# Facts about this board for the shell scripts (build.sh, emulation/run.sh,
# emulation/selftest.sh, benchmark runners). Sourced by emulation/renode.sh.
BOARD_TITLE="STM32H747I-DISCO (Cortex-M7)"
BOARD_GDB=arm-none-eabi-gdb
BOARD_SHELL_UART=sysbus.usart1   # Renode name of the shell UART
BOARD_RB_TIMER_HZ=250000000      # RTOS-Benchmark timer clock in Renode (DWT); empty = no benchmarks
