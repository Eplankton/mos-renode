:name: STM32F4_Discovery
:description: MOS RTOS on STM32F4-Discovery (Cortex-M4)

# Run from the repository root:
#   renode --console emulation/stm32f4-disco/debug.resc
# Then use VS Code "Cortex Debug (F4)" or connect GDB to localhost:1234.
$name?="STM32F4_Discovery"
$add_on_repl?=$CWD/emulation/stm32f4-disco/add_on.repl
$bin_path?=$CWD/build/stm32f4-disco/stm32f4-disco.elf

mach create $name
machine LoadPlatformDescription @platforms/boards/stm32f4_discovery-kit.repl
machine LoadPlatformDescription $add_on_repl

# The F4 BSP currently runs from the reset HSI clock (16 MHz).
sysbus.nvic Frequency 16000000

# GDB for cortex-debug / arm-none-eabi-gdb
machine StartGdbServer 1234

macro reset
"""
    sysbus LoadELF $bin_path
"""

runMacro $reset

logLevel -1 gpioPortA.myLED

# Shell UART (USART2) -> TCP 3333
emulation CreateServerSocketTerminal 3333 "uart-con" false
connector Connect sysbus.usart2 uart-con

# Readiness marker used by emulation/run.sh
echo "MOS_RENODE_READY"
