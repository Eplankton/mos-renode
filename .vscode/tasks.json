{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Build (F4)",
            "type": "shell",
            "command": "./build.sh stm32f4-disco",
            "problemMatcher": ["$gcc"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "CMake Build (H7)",
            "type": "shell",
            "command": "./build.sh stm32h7-disco",
            "problemMatcher": ["$gcc"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Run Renode (F4)",
            "type": "shell",
            "command": "renode",
            "args": [
                "--console",
                "${workspaceFolder}/emulation/stm32f4-disco/debug.resc"
            ],
            "dependsOn": ["CMake Build (F4)"],
            "isBackground": true,
            "problemMatcher": {
                "source": "Renode",
                "pattern": {
                    "regexp": ""
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Renode, version .*",
                    "endsPattern": ".*MOS_RENODE_READY.*"
                }
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Run Renode (H7)",
            "type": "shell",
            "command": "renode",
            "args": [
                "--console",
                "${workspaceFolder}/emulation/stm32h7-disco/debug.resc"
            ],
            "dependsOn": ["CMake Build (H7)"],
            "isBackground": true,
            "problemMatcher": {
                "source": "Renode",
                "pattern": {
                    "regexp": ""
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Renode, version .*",
                    "endsPattern": ".*MOS_RENODE_READY.*"
                }
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Run Renode (F4 multi-machine)",
            "type": "shell",
            "command": "renode",
            "args": [
                "--console",
                "${workspaceFolder}/emulation/stm32f4-disco/multi_mach.resc"
            ],
            "dependsOn": ["CMake Build (F4)"],
            "isBackground": true,
            "problemMatcher": {
                "source": "Renode",
                "pattern": {
                    "regexp": ""
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Renode, version .*",
                    "endsPattern": ".*MOS_RENODE_READY.*"
                }
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Run Renode (H7 multi-machine)",
            "type": "shell",
            "command": "renode",
            "args": [
                "--console",
                "${workspaceFolder}/emulation/stm32h7-disco/multi_mach.resc"
            ],
            "dependsOn": ["CMake Build (H7)"],
            "isBackground": true,
            "problemMatcher": {
                "source": "Renode",
                "pattern": {
                    "regexp": ""
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Renode, version .*",
                    "endsPattern": ".*MOS_RENODE_READY.*"
                }
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Close Renode",
            "command": "exit",
            "type": "shell",
            "problemMatcher": []
        }
    ]
}
