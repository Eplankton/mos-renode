{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug (F4)",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/stm32f4-disco/stm32f4-disco.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "external",
            "gdbTarget": "localhost:1234",
            "gdbPath": "arm-none-eabi-gdb",
            "preLaunchTask": "Run Renode (F4)",
            "postDebugTask": "Close Renode",
            "runToEntryPoint": "main",
            "loadFiles": [
                "${workspaceRoot}/build/stm32f4-disco/stm32f4-disco.elf"
            ],
            "symbolFiles": [
                {
                    "file": "${workspaceRoot}/build/stm32f4-disco/stm32f4-disco.elf"
                }
            ]
        },
        {
            "name": "Cortex Debug (H7)",
            "cwd": "${workspaceRoot}",
