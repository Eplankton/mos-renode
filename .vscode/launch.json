            "request": "launch",
            "type": "cortex-debug",
            "servertype": "external",
            "gdbTarget": "localhost:1234",
            "gdbPath": "arm-none-eabi-gdb",
            "preLaunchTask": "Run Renode (H7)",
            "postDebugTask": "Close Renode",
            "runToEntryPoint": "main",
            "loadFiles": [
                "${workspaceRoot}/build/stm32h7-disco/stm32h7-disco.elf"
            ],
